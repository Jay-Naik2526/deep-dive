# Analytics is OFF until one of these is set. Both are cookie-free and need no consent banner.
# GoatCounter (free): create a site at goatcounter.com, then put its code here (the part before .goatcounter.com).
VITE_GOATCOUNTER=
# Plausible: put the domain you registered there, e.g. jaynaik.tech
VITE_PLAUSIBLE_DOMAIN=

# Ask the diver: URL of the deployed Cloudflare worker (see worker/README.md). Empty = offline engine only.
VITE_ASK_URL=
